          "first_process_completed_steps": 2
        }
      }
    },
    {
      "id": "long-alternative-tool-continuation",
      "name": "Alternative tool preserves original step identity and continues",
      "suite": "long_task",
      "kind": "alternative_tool_continuation",
      "max_duration_ms": 3000,
      "expected": {
        "accepted": true,
        "status": "completed",
        "recovered": true,
        "metrics": {
          "primary_failures": 1,
          "completed_prefix_replays": 0,
