    {
      "id": "long-retry-budget-dead-letter",
      "name": "Retry budget exhaustion becomes visible dead-letter state",
      "suite": "long_task",
      "kind": "retry_budget_dead_letter",
      "max_duration_ms": 3000,
      "expected": {
        "accepted": false,
        "status": "recovering",
        "recovered": false,
        "metrics": {
          "initially_recoverable": true,
          "retry_scheduled": true,
          "dead_lettered": true,
          "retry_attempts": 2,
          "false_completions": 0,
          "abandoned_runs": 0
        }
      }
    },
    {
      "id": "long-cooperative-cancel",
      "name": "Cooperative cancellation stops before the next required step",
      "suite": "long_task",
      "kind": "cooperative_cancel",
      "max_duration_ms": 3000,
      "expected": {
        "accepted": false,
        "status": "cancelled",
        "recovered": false,
        "metrics": {
          "worker_parked": true,
          "remaining_tool_calls": 0,
          "cancel_checkpoint": true,
          "false_completions": 0
        }
      }
