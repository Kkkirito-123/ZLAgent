# ============================================================================
# ZLAgent .env.example
#
# Copy this file to .env and fill in the values you need.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows PowerShell / cmd)
#
# Every entry is optional — the bot starts in echo-only mode if no LLM
# key is configured. See backend/core/config.py for the full Settings
# schema and additional advanced flags.
# ============================================================================

# ---- LLM (required for real replies; otherwise falls back to echo) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# ---- Optional intent router (cheap Flash model used to pre-filter skills) ----
# Pre-screens skill / knowledge-mode candidates before the main LLM call.
ZLAGENT_ROUTER_LLM_ENABLED=false
ZLAGENT_ROUTER_LLM_MODEL=

# ---- Memory ----
ZLAGENT_MEMORY_MAX_ENTRIES=200
ZLAGENT_MEMORY_MAX_ENTRY_CHARS=500

# ---- Tool safety ----
ZLAGENT_TOOL_GUARDRAILS_HARD_STOP_ENABLED=true
ZLAGENT_SKILL_GUARD_ENABLED=true
ZLAGENT_SKILL_GUARD_STRICT_FOR_AGENT=true

# ---- Context compression ----
ZLAGENT_CONTEXT_SUMMARY_ENABLED=true
ZLAGENT_CONTEXT_SUMMARY_THRESHOLD_CHARS=49152

# ---- GraphRAG (LLM-driven knowledge graph extraction) ----
ZLAGENT_GRAPH_LLM_ENABLED=true

# ---- MCP ----
ZLAGENT_MCP_ENABLED=true

# ---- OpenGUI phone executor ----
ZLAGENT_OPENGUI_ENABLED=true
ZLAGENT_OPENGUI_BASE_URL=http://host.docker.internal:7777
ZLAGENT_OPENGUI_TIMEOUT_SECONDS=15

# ---- Web search (all optional; DuckDuckGo + Bing run with zero config) ----
TAVILY_API_KEY=
ZLAGENT_SEARXNG_URL=

# ---- Backing services (defaults match docker-compose.yml) ----
DATABASE_URL=postgresql+psycopg://zlagent:zlagent@postgres:5432/zlagent
ZLAGENT_REDIS_URL=redis://redis:6379/0

# ---- IM gateways (configure the ones you actually use) ----
# WeChat (custom in-house relay)
WEIXIN_BASE_URL=

# ---- Server ----
ZLAGENT_HOST=0.0.0.0
ZLAGENT_PORT=8020
ZLAGENT_LOG_LEVEL=INFO
